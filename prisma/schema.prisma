generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Environment {
  production
  development
}

model DailyExercise {
  id          Int         @id @default(autoincrement())
  environment Environment
  // The Budapest date (one email per day per environment); in dev mode an ISO timestamp.
  slot        String
  date        DateTime    @db.Date
  difficulty  String
  topic       String
  exercise    String
  solution    String
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([environment, slot])
  @@index([environment, createdAt])
  @@map("daily_exercises")
}
