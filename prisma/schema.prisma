generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Environment {
  production
  development
}

model DailyExercise {
  id          Int          @id @default(autoincrement())
  environment Environment
  // The Budapest date (one email per day per environment); in dev mode an ISO timestamp.
  slot        String
  date        DateTime     @db.Date
  difficulty  String
  topic       String
  exercise    String
  solution    String
  createdAt   DateTime     @default(now()) @map("created_at")
  submissions Submission[]

  @@unique([environment, slot])
  @@index([environment, createdAt])
  @@map("daily_exercises")
}

model Submission {
  id             Int           @id @default(autoincrement())
  exerciseId     Int           @map("exercise_id")
  exercise       DailyExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  // The sender's address, lowercased.
  email          String
  replyMessageId String        @map("reply_message_id")
  receivedAt     DateTime      @map("received_at")
  score          Int
  feedback       String
  gradedAt       DateTime      @default(now()) @map("graded_at")

  @@unique([exerciseId, email])
  @@map("submissions")
}

model Participant {
  id          Int         @id @default(autoincrement())
  environment Environment
  // Lowercased; the migration also checks the format.
  email       String
  name        String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([environment, email])
  @@map("participants")
}
